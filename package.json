{
  "name": "nimbly-docs",
  "version": "0.0.2",
  "description": "A single-bundle, zero-dependency, embeddable Markdown documentation viewer Web Component. A modern, secure alternative to Docsify.",
  "type": "module",
  "license": "MIT",
  "author": "Nimbly Docs contributors",
  "keywords": [
    "documentation",
    "markdown",
    "docsify",
    "web-component",
    "viewer",
    "embeddable",
    "docs",
    "static-site"
  ],
  "main": "./dist/nimbly-docs.min.js",
  "module": "./dist/nimbly-docs.min.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/nimbly-docs.min.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && node scripts/build.mjs && npm run types",
    "build:dev": "node scripts/build.mjs --dev",
    "types": "tsc -p tsconfig.json --emitDeclarationOnly --declaration --outDir dist/types",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "size": "node scripts/build.mjs && node scripts/size.mjs",
    "pages": "node scripts/pages.mjs",
    "test": "node --test tests/",
    "dev": "node scripts/build.mjs --dev --watch",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}

{
  "swagger": "2.0",
  "info": { "title": "Orders service", "version": "0.9.0", "description": "A legacy **Swagger 2.0** JSON description, rendered with the same viewer." },
  "host": "orders.internal.example",
  "basePath": "/api",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "paths": {
    "/orders/{id}": {
      "get": {
        "operationId": "getOrder",
        "summary": "Read an order",
        "parameters": [{ "name": "id", "in": "path", "required": true, "type": "integer", "format": "int64" }],
        "responses": {
          "200": { "description": "The order", "schema": { "$ref": "#/definitions/Order" } },
          "404": { "description": "Not found" }
        }
      },
      "put": {
        "operationId": "updateOrder",
        "summary": "Replace an order",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "integer" },
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/Order" } }
        ],
        "responses": { "200": { "description": "Updated", "schema": { "$ref": "#/definitions/Order" } } }
      }
    }
  },
  "definitions": {
    "Order": {
      "type": "object",
      "required": ["id", "lines"],
      "properties": {
        "id": { "type": "integer", "format": "int64" },
        "lines": { "type": "array", "items": { "$ref": "#/definitions/Line" } },
        "status": { "type": "string", "enum": ["open", "paid", "shipped"] }
      }
    },
    "Line": {
      "type": "object",
      "properties": { "sku": { "type": "string" }, "quantity": { "type": "integer", "minimum": 1 } }
    }
  }
}

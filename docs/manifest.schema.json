{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nimbly-docs.github.io/nimbly-docs/manifest/v1/schema.json",
  "title": "Nimbly Docs Manifest v1",
  "type": "object",
  "required": ["version", "title", "sections"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^1(\\.|$)" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "language": { "type": "string" },
    "theme": { "type": "string" },
    "home": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]{0,127}$" },
    "logo": { "type": "string" },
    "editBase": { "type": "string" },
    "footer": { "type": "string" },
    "features": { "$ref": "#/$defs/features" },
    "themes": { "type": "array", "items": { "$ref": "#/$defs/theme" } },
    "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]{0,127}$" },
    "page": { "type": "object", "required": ["id", "title", "source"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 }, "source": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "badge": { "type": "string" }, "hidden": { "type": "boolean" } }, "additionalProperties": true },
    "section": { "type": "object", "required": ["id", "title"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 }, "icon": { "type": "string" }, "collapsed": { "type": "boolean" }, "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } }, "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } } }, "additionalProperties": true },
    "features": { "type": "object", "properties": { "search": { "type": "boolean" }, "toc": { "type": "boolean" }, "copyCode": { "type": "boolean" }, "previousNext": { "type": "boolean" }, "breadcrumbs": { "type": "boolean" }, "editLink": { "type": "boolean" }, "sidebar": { "type": "object", "properties": { "collapsible": { "type": "boolean" }, "defaultExpanded": { "type": "array", "items": { "type": "string" } } } } }, "additionalProperties": true },
    "theme": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "base": { "enum": ["nimbus", "midnight", "paper", "sabbia"] }, "light": { "type": "object", "additionalProperties": { "type": "string" } }, "dark": { "type": "object", "additionalProperties": { "type": "string" } } }, "additionalProperties": false }
  }
}

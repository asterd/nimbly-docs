{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nimbly-docs.github.io/nimbly-docs/manifest/v1/schema.json",
  "title": "Nimbly Docs Manifest v1",
  "type": "object",
  "required": [
    "version",
    "title",
    "sections"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^1(\\.|$)"
    },
    "title": {
      "$ref": "#/$defs/localizable"
    },
    "description": {
      "$ref": "#/$defs/localizable"
    },
    "language": {
      "type": "string"
    },
    "theme": {
      "type": "string"
    },
    "chooseThemes": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "home": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9/_-]{0,127}$"
    },
    "appearance": {
      "enum": [
        "light",
        "dark",
        "auto"
      ]
    },
    "backLink": {
      "$ref": "#/$defs/backLink"
    },
    "logo": {
      "type": "string"
    },
    "editBase": {
      "type": "string"
    },
    "footer": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "apiReference": {
      "$ref": "#/$defs/apiReference"
    },
    "languages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/language"
      }
    },
    "versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/docVersion"
      }
    },
    "features": {
      "$ref": "#/$defs/features"
    },
    "themes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/theme"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/attachment"
          },
          {
            "required": [
              "id"
            ]
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9/_-]{0,127}$"
    },
    "localizable": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "page": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/localizable"
        },
        "source": {
          "$ref": "#/$defs/localizable"
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "description": {
          "$ref": "#/$defs/localizable"
        },
        "badge": {
          "$ref": "#/$defs/badge"
        },
        "hidden": {
          "type": "boolean"
        },
        "attachments": {
          "$ref": "#/$defs/attachmentList"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "api": {
          "$ref": "#/$defs/localizable",
          "description": "OpenAPI 3.x / Swagger 2.0 description (JSON or YAML) rendered as an integrated, read-only API reference instead of Markdown."
        },
        "link": {
          "type": "string",
          "description": "External URL: the sidebar entry opens it in a new tab instead of routing."
        }
      },
      "additionalProperties": true
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/localizable"
        },
        "icon": {
          "type": "string"
        },
        "collapsed": {
          "type": "boolean"
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/page"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "attachments": {
          "$ref": "#/$defs/attachmentList"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "badge": {
          "$ref": "#/$defs/badge",
          "description": "Badge next to the section title, at any nesting level."
        }
      },
      "additionalProperties": true
    },
    "link": {
      "type": "object",
      "required": [
        "type",
        "url"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "apiReference": {
      "type": "object",
      "description": "Pinned sidebar API reference. `spec` renders the description inside the docs; `url` links out.",
      "properties": {
        "spec": {
          "type": "string",
          "description": "OpenAPI/Swagger description rendered inside the docs."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "External reference URL (used when no spec is given)."
        },
        "id": {
          "$ref": "#/$defs/id",
          "description": "Route id of the integrated page. Default api-reference."
        },
        "label": {
          "$ref": "#/$defs/localizable"
        }
      },
      "anyOf": [
        {
          "required": [
            "spec"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ],
      "additionalProperties": false
    },
    "backLink": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/localizable"
        }
      },
      "additionalProperties": false
    },
    "language": {
      "type": "object",
      "required": [
        "code",
        "label"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[a-z0-9]{2,8})?$"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "properties": {
        "search": {
          "type": "boolean"
        },
        "toc": {
          "type": "boolean"
        },
        "copyCode": {
          "type": "boolean"
        },
        "previousNext": {
          "type": "boolean"
        },
        "breadcrumbs": {
          "type": "boolean"
        },
        "editLink": {
          "type": "boolean"
        },
        "sidebar": {
          "type": "object",
          "properties": {
            "collapsible": {
              "type": "boolean"
            },
            "defaultExpanded": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "sourceDownload": {
          "type": "boolean",
          "default": false
        },
        "lightbox": {
          "type": "boolean",
          "default": true,
          "description": "Open content images and diagrams in the in-page viewer."
        }
      },
      "additionalProperties": true
    },
    "docVersion": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"
        },
        "label": {
          "type": "string"
        },
        "manifest": {
          "type": "string"
        },
        "status": {
          "enum": [
            "current",
            "legacy",
            "unreleased"
          ]
        }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "base": {
          "enum": [
            "nimbly",
            "nimbus",
            "midnight",
            "paper",
            "sabbia",
            "material",
            "stellar",
            "evergreen"
          ]
        },
        "light": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "dark": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "badge": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "$ref": "#/$defs/localizable"
            },
            "tone": {
              "enum": [
                "neutral",
                "success",
                "warning",
                "danger",
                "info"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "attachment": {
      "type": "object",
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/localizable"
        },
        "url": {
          "type": "string"
        },
        "description": {
          "$ref": "#/$defs/localizable"
        },
        "group": {
          "$ref": "#/$defs/localizable"
        },
        "mediaType": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "download": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "attachmentList": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/attachment"
          }
        ]
      }
    },
    "revision": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "maxLength": 1024
        },
        "commit": {
          "type": "string",
          "maxLength": 1024
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 1024
        },
        "source": {
          "type": "string",
          "maxLength": 1024
        },
        "branchTone": {
          "enum": [
            "neutral",
            "success",
            "warning",
            "danger",
            "info"
          ]
        },
        "status": {
          "$ref": "#/$defs/badge"
        }
      },
      "additionalProperties": false
    }
  }
}
